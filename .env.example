# One file for both the frontend (only VITE_-prefixed vars are exposed to
# the browser) and the API routes (everything else stays server-only).
# Copy this to .env, fill it in, then run `npx vercel dev` for full local
# testing (frontend + API routes together). See README.md for setup steps.

# From Google Cloud Console > APIs & Services > Credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Local dev (via `vercel dev`, default port 3000):
#   http://localhost:3000/api/auth/callback
# Production: https://YOUR-APP.vercel.app/api/auth/callback
GOOGLE_REDIRECT_URI=http://localhost:3000/api/auth/callback

# The playlist friends will add songs to. Grab it from the playlist's URL:
# https://music.youtube.com/playlist?list=THIS_PART_HERE
YOUTUBE_PLAYLIST_ID=

# From your Supabase project > Project Settings > API
SUPABASE_URL=
# The "service_role" secret key — NOT the "anon" public key. Never prefix
# this with VITE_ or it would ship to the browser.
SUPABASE_SERVICE_ROLE_KEY=
